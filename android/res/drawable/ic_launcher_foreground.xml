<?xml version="1.0" encoding="utf-8"?>
<!-- Astro launcher icon: ringed planet and stars (same art as assets/astro-launcher.svg).
     Everything stays inside the 66dp safe zone of the 108dp adaptive icon canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- stars -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,30 l1.2,3.2 3.2,1.2 -3.2,1.2 -1.2,3.2 -1.2,-3.2 -3.2,-1.2 3.2,-1.2z" />
    <path
        android:fillColor="#BFF6FF"
        android:pathData="M76,74 l1,2.6 2.6,1 -2.6,1 -1,2.6 -1,-2.6 -2.6,-1 2.6,-1z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M72,30 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0" />

    <!-- back half of the ring -->
    <group android:rotation="-24" android:pivotX="54" android:pivotY="54">
        <path
            android:strokeColor="#99FFB347"
            android:strokeWidth="4.5"
            android:pathData="M24,54 A30,8 0 0,1 84,54" />
    </group>

    <!-- planet -->
    <path
        android:fillColor="#C43FD8"
        android:pathData="M54,54 m-17,0 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0" />
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M47,46 m-8,0 a8,6 -30 1,0 16,0 a8,6 -30 1,0 -16,0" />
    <path
        android:fillColor="#3A1B9A"
        android:fillAlpha="0.55"
        android:pathData="M54,54 m-17,0 a17,17 0 0,0 34,0 a14,12 0 0,1 -34,0z" />

    <!-- front half of the ring -->
    <group android:rotation="-24" android:pivotX="54" android:pivotY="54">
        <path
            android:strokeColor="#FFD166"
            android:strokeWidth="4.5"
            android:pathData="M24,54 A30,8 0 0,0 84,54" />
    </group>
</vector>

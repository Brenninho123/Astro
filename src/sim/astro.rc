/* Windows resources for the simulator executable (compiled with windres from the repo root). */
1 ICON "assets/astro.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Astro OS Simulator"
            VALUE "ProductName", "Astro OS"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "astro-sim.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
